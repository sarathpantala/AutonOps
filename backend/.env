# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/autonops

# Application
APP_NAME=AutonOps Backend - A junior SRE that never sleeps
DEBUG=True
SECRET_KEY=your-secret-key-here

# Logging
LOG_LEVEL=INFO

# AI
OPENAI_API_KEY=your-openai-api-key-here

# Kubernetes
KUBECONFIG_PATH=~/.kube/config

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google OAuth
GOOGLE_CLIENT_ID=client-id
GOOGLE_CLIENT_SECRET=client-secret
GOOGLE_REDIRECT_URI=http://localhost:4173/auth/callback